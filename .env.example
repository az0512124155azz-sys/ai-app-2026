# Example .env - מלאו את ה-API keys שלכם
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Models keys
NIM_GENERAL_API_KEY=put_your_general_key_here
NIM_REASONING_API_KEY=put_your_reasoning_key_here
